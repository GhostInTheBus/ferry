# Copy to .env and fill in. .env is never committed.

# Password for the first sign in. Change it later in Settings.
FERRY_PASSWORD=

# Your user and group ids on the NAS (run `id` over SSH)
PUID=1000
PGID=100
# Synology: 101 is the administrators group, needed to move deletes into #recycle
EXTRA_GID=100

# Folder on the NAS that shows up in Ferry, and what to call it
FERRY_FILES=/volume1
FERRY_LOCAL_NAME=NAS

# Where Ferry keeps its database, SSH key and thumbnail cache
FERRY_DATA_DIR=./data

# 127.0.0.1 = only reachable through Tailscale or a proxy on the NAS itself
FERRY_BIND=127.0.0.1
